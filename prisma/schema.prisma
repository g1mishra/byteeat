generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id             String         @id @default(uuid())
  name           String
  tableSize      Int
  address_string String
  city           String
  state          String
  country        String         @default("India")
  slug           String         @unique
  logoUrl        String         @default("")
  ItemCategory   ItemCategory[]
  SocialLinks    SocialLinks?
  user           User           @relation(fields: [userId], references: [id])
  userId         String
  Order          Order[]
  subscription   Subscription?
  createdAt      DateTime       @default(now()) @db.Timestamptz()
  updatedAt      DateTime       @default(now()) @updatedAt @db.Timestamptz()
  isActive       Boolean        @default(true)

  @@unique([name, address_string])
  @@index([slug])
}

model ItemCategory {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  categoryName String
  Item         Item[]
  position     Int        @default(autoincrement())

  @@unique([restaurantId, categoryName])
}

enum ItemType {
  FOOD
  BEVERAGE
  BAR
}

model Item {
  id           String         @id @default(uuid())
  category     ItemCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId   String
  isVeg        Boolean        @default(true)
  description  String         @default("")
  imgPath      String         @default("")
  dish         String
  type         ItemType       @default(FOOD)
  PriceItemMap PriceItemMap[]
  position     Int            @default(autoincrement())
  isActive     Boolean        @default(true)
  OrderItem    OrderItem[]

  @@index([dish])
}

model PriceItemMap {
  id      String  @id @default(uuid())
  item    Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId  String
  price   Decimal @db.Decimal(10, 2)
  portion String  @default("null")

  @@unique([itemId, portion])
}

model SocialLinks {
  id           String     @id @default(uuid())
  facebook     String     @default("")
  instagram    String     @default("")
  twitter      String     @default("")
  whatsapp     String     @default("")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String     @unique
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime @db.Timestamptz()
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?    @map("email_verified") @db.Timestamptz()
  phone         String?      @unique
  password      String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  restaurants   Restaurant[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz()

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model OrderItem {
  id       String  @id @default(uuid())
  item     Item    @relation(fields: [itemId], references: [id])
  itemId   String
  portion  String
  price    Decimal @db.Decimal(10, 2)
  quantity Int
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId  String
}

enum OrderStatus {
  PENDING
  ACCEPTED
  DELIVERED
  CANCELLED
}

model Order {
  id           String      @id @default(uuid())
  orderItems   OrderItem[]
  total        Decimal     @db.Decimal(10, 2)
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  status       OrderStatus @default(PENDING)
  createdAt    DateTime    @default(now()) @db.Timestamptz()
  updatedAt    DateTime    @updatedAt @db.Timestamptz()
  tableNo      Int         @default(0)

  @@index([status])
}

enum PlanType {
  STARTER
  PRO
}

model Plan {
  id            String         @id @default(uuid())
  type          PlanType       @unique
  name          String
  description   String
  price         Decimal        @db.Decimal(10, 2)
  interval      String // e.g., "month", "year"
  currency      String         @default("INR")
  isDefault     Boolean        @default(false)
  features      Json
  subscriptions Subscription[]
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

model Subscription {
  id               String             @id @default(uuid())
  restaurant       Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId     String             @unique
  plan             Plan               @relation(fields: [planType], references: [type])
  planType         PlanType
  startDate        DateTime           @default(now()) @db.Timestamptz()
  endDate          DateTime?          @db.Timestamptz()
  status           SubscriptionStatus @default(ACTIVE)
  freeTrialEndDate DateTime?          @db.Timestamptz()

  @@index([status])
}
