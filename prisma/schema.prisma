generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model Restaurant {
  id                  Int            @id @default(autoincrement())
  name                String
  tableSize           Int
  address_string      String
  city                String
  state               String
  country             String          @default("India")
  ItemCategory ItemCategory[]
}


model ItemCategory {
  id               Int                @id @default(autoincrement())
  restaurant       Restaurant         @relation(fields: [restaurantId], references: [id])
  restaurantId     Int
  categoryName     String @unique
  Item             Item[]
  CategoryPosition CategoryPosition[]
  address_string    String
  city              String
  state             String
  country           String         @default("India")
}

model Item {
  id           Int            @id @default(autoincrement())
  category     ItemCategory   @relation(fields: [categoryId], references: [id])
  categoryId   Int
  // foodOrBar    String         @default("Food")
  // make it boolean
  isVeg  Boolean        @default(true)
  foodOrBar    Boolean        @default(true)
  description  String         @default("")
  imgPath      String         @default("")
  dish         String
  PriceItemMap PriceItemMap[]
  ItemPosition ItemPosition[]
}

model PriceItemMap {
  id      Int    @id @default(autoincrement())
  item    Item   @relation(fields: [itemId], references: [id])
  itemId  Int
  price   Float
  portion String @default("null")
}

model CategoryPosition {
  id         Int          @id @default(autoincrement())
  catPos     Int          @default(autoincrement())
  category   ItemCategory @relation(fields: [categoryId], references: [id])
  categoryId Int
}

model ItemPosition {
  id      Int  @id @default(autoincrement())
  itemPos Int  @default(autoincrement())
  item    Item @relation(fields: [itemId], references: [id])
  itemId  Int
}


