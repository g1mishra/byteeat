// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id           Int            @id @default(autoincrement())
  name         String
  tableSize    Int
  address      String
  menus        Item[]
  ItemCategory ItemCategory[]
}

model ItemCategory {
  id               Int                @id @default(autoincrement())
  restaurant       Restaurant         @relation(fields: [restaurantId], references: [id]) 
  restaurantId     Int                
  categoryName     String
  Item             Item[]
  CategoryPosition CategoryPosition[]
}

model Item {
  id           Int            @id @default(autoincrement())
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id])
  restaurantId Int
  category     ItemCategory   @relation(fields: [categoryId], references: [id])
  categoryId   Int
  vegOrNonVeg  String         @default("Veg")
  foodOrBar    String         @default("Food")
  description  String         @default("")
  imgPath      String         @default("")
  dish         String
  PriceItemMap PriceItemMap[]
  ItemPosition ItemPosition[]
}

model PriceItemMap {
  id      Int    @id @default(autoincrement())
  item    Item   @relation(fields: [itemId], references: [id])
  itemId  Int
  price   Float
  portion String
}

model CategoryPosition {
  id         Int          @id @default(autoincrement())
  catPos     Int          @default(autoincrement())
  category   ItemCategory @relation(fields: [categoryId], references: [id])
  categoryId Int
}

model ItemPosition {
  id      Int  @id @default(autoincrement())
  itemPos Int  @default(autoincrement())
  item    Item @relation(fields: [itemId], references: [id])
  itemId  Int
}

// create postgreSQL database
