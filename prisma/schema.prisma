// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  tableSize       Int
  address_string  String
  city            String
  state           String
  country         String         @default("India")
  slug            String         @unique
  logoUrl         String         @default("")
  joiningKey      JoiningKey?
  ItemCategory    ItemCategory[]
  SocialLinks     SocialLinks?
  userRestaurants UserRestaurant[]
  Order           Order[]
  subscription    Subscription?
  selfOrdering    Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  isActive        Boolean        @default(true)
  addons          Addon[]
  theme           Json?          @default("{}")
}

model UserRestaurant {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  user         User       @relation(fields: [userId], references: [id])
  userId       String     @db.ObjectId
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @db.ObjectId

  @@unique([userId, restaurantId])
}

model ItemCategory {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @db.ObjectId
  categoryName String
  Item         Item[]
  position     Int

  @@unique([restaurantId, categoryName])
}

enum ItemType {
  FOOD
  BEVERAGE
  BAR
}

model Item {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  category     ItemCategory   @relation(fields: [categoryId], references: [id])
  categoryId   String         @db.ObjectId
  isVeg        Boolean        @default(true)
  description  String         @default("")
  imgPath      String         @default("")
  dish         String
  type         ItemType       @default(FOOD)
  PriceItemMap PriceItemMap[]
  position     Int
  isActive     Boolean        @default(true)
  addons       Addon[]        @relation(fields: [addonIds], references: [id])
  addonIds     String[]       @db.ObjectId
}

model PriceItemMap {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  item    Item   @relation(fields: [itemId], references: [id])
  itemId  String @db.ObjectId
  price   Float
  portion String @default("")

  @@unique([itemId, portion])
}

model SocialLinks {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  facebook     String     @default("")
  instagram    String     @default("")
  twitter      String     @default("")
  whatsapp     String     @default("")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @unique @db.ObjectId
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model User {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String           @unique
  emailVerified DateTime?
  phone         String?          @unique
  password      String?
  image         String?
  role          Role?
  accounts      Account[]
  sessions      Session[]
  userRestaurants UserRestaurant[]
  orders        Order[]
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model OrderItem {
  id       String           @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  itemId   String
  portion  String
  price    Float
  quantity Int
  order    Order            @relation(fields: [orderId], references: [id])
  orderId  String           @db.ObjectId
  addons   OrderItemAddon[]
}

model OrderItemAddon {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  orderItemId String    @db.ObjectId
  addon       Addon     @relation(fields: [addonId], references: [id])
  addonId     String    @db.ObjectId
  quantity    Int       @default(1)

  @@unique([orderItemId, addonId])
}

enum OrderStatus {
  PENDING
  ACCEPTED
  DELIVERED
  CANCELLED
}

enum OrderType {
  QR
  MANUAL
}

model Order {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  orderItems   OrderItem[]
  subtotal     Float       @default(0)
  discount     Float       @default(0)
  total        Float
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  restaurantId String      @db.ObjectId
  status       OrderStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  tableNo      Int         @default(0)
  user         User        @relation(fields: [userId], references: [id])
  userId       String      @db.ObjectId
  type         OrderType   @default(QR)
}

enum PlanType {
  STARTER
  PRO
  ENTERPRISE
}

model Plan {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  type          PlanType       @unique
  name          String
  description   String
  price         Float
  interval      String // e.g., "month", "year"
  currency      String         @default("INR")
  isDefault     Boolean        @default(false)
  features      Json
  subscriptions Subscription[]
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

enum Role {
  OWNER
  WAITER
}

model Subscription {
  id               String             @id @default(auto()) @map("_id") @db.ObjectId
  restaurant       Restaurant         @relation(fields: [restaurantId], references: [id])
  restaurantId     String             @unique @db.ObjectId
  plan             Plan               @relation(fields: [planType], references: [type])
  planType         PlanType           @default(STARTER)
  startDate        DateTime           @default(now())
  endDate          DateTime?
  status           SubscriptionStatus @default(ACTIVE)
  freeTrialEndDate DateTime?
}

model JoiningKey {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  field        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  expiresAt    DateTime?
  restaurantId String     @unique @db.ObjectId
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
}

model Addon {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  price        Float
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id])
  restaurantId String           @db.ObjectId
  items        Item[]           @relation(fields: [itemIds], references: [id])
  itemIds      String[]         @db.ObjectId
  orderItems   OrderItemAddon[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}