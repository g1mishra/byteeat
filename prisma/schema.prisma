generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id             String         @id @default(uuid())
  name           String
  tableSize      Int
  address_string String
  city           String
  state          String
  country        String         @default("India")
  ItemCategory   ItemCategory[]
}

model ItemCategory {
  id               String             @id @default(uuid())
  restaurant       Restaurant         @relation(fields: [restaurantId], references: [id])
  restaurantId     String
  categoryName     String             @unique
  Item             Item[]
  CategoryPosition CategoryPosition[]
}

model Item {
  id           String         @id @default(uuid())
  category     ItemCategory   @relation(fields: [categoryId], references: [id])
  categoryId   String
  // foodOrBar    String         @default("Food")
  // make it boolean
  isVeg        Boolean        @default(true)
  foodOrBar    Boolean        @default(true)
  description  String         @default("")
  imgPath      String         @default("")
  dish         String
  PriceItemMap PriceItemMap[]
  ItemPosition ItemPosition[]
}

model PriceItemMap {
  id      String @id @default(uuid())
  item    Item   @relation(fields: [itemId], references: [id])
  itemId  String
  price   Float
  portion String @default("null")
}

model CategoryPosition {
  id         String       @id @default(uuid())
  catPos     Int          @default(autoincrement())
  category   ItemCategory @relation(fields: [categoryId], references: [id])
  categoryId String
}

model ItemPosition {
  id      String @id @default(uuid())
  itemPos Int    @default(autoincrement())
  item    Item   @relation(fields: [itemId], references: [id])
  itemId  String
}

