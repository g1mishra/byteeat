# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Database configuration - MongoDB
# For local MongoDB: mongodb://localhost:27017/byte_eat_db
# For MongoDB Atlas (free tier): https://www.mongodb.com/cloud/atlas/register
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/byte_eat_db?retryWrites=true&w=majority"

# Image Upload - Cloudinary (Free tier: 25 credits/month, 25GB storage, 25GB bandwidth)
# Sign up at https://cloudinary.com/users/register/free
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your_upload_preset"

# Alternative Free Image Storage Options:
# 1. UploadThing (Free tier: 2GB storage, 2GB bandwidth) - https://uploadthing.com
# 2. ImageKit (Free tier: 20GB bandwidth/month) - https://imagekit.io
# 3. Supabase Storage (Free tier: 1GB storage) - https://supabase.com

# Authentication - Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# NextAuth
NEXTAUTH_SECRET="your_nextauth_secret"
NEXTAUTH_URL="http://localhost:3000"

# Base Domain
NEXT_PUBLIC_BASE_DOMAIN="localhost:3000"

# Email - Resend (Free tier: 100 emails/day, 3,000/month)
RESEND_API_KEY="your_resend_api_key"